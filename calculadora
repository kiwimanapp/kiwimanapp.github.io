<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Beneficios - The Kiwi Store</title>
    <style>
        :root {
            --primary: #2E7D32;
            --primary-light: #4CAF50;
            --bg-color: #f4f6f8;
            --card-bg: #ffffff;
            --text-color: #333333;
            --border-color: #dddddd;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .calculator-container {
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            width: 100%;
            max-width: 600px;
        }

        h2 {
            margin-top: 0;
            color: var(--primary);
            text-align: center;
            margin-bottom: 25px;
        }

        .input-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            font-size: 14px;
        }

        input[type="number"] {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="number"]:focus {
            border-color: var(--primary-light);
        }

        .results {
            margin-top: 25px;
            border-top: 2px solid var(--border-color);
            padding-top: 20px;
        }

        .result-box {
            background-color: #f9fbf9;
            border: 1px solid #d4edda;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .result-title {
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 10px;
            font-size: 15px;
            border-bottom: 1px dashed #c3e6cb;
            padding-bottom: 5px;
        }

        .result-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .result-item span:last-child {
            font-weight: bold;
        }

        .highlight-green {
            color: #2e7d32;
        }

        .highlight-red {
            color: #c62828;
        }
    </style>
</head>
<body>

<div class="calculator-container">
    <h2>Calculadora por Operación - The Kiwi Store</h2>
    
    <div class="input-group">
        <label for="costeProducto">Coste del producto (Sin IVA):</label>
        <input type="number" id="costeProducto" placeholder="Ej: 5.00" step="0.01" min="0" oninput="calcular()">
    </div>

    <div class="input-group">
        <label for="gastosEnvio">Gastos de envío del proveedor (Sin IVA):</label>
        <input type="number" id="gastosEnvio" placeholder="Ej: 0.00" step="0.01" min="0" oninput="calcular()">
    </div>

    <div class="input-group">
        <label for="precioVenta">Precio de Venta al Cliente (PVP con IVA incluido):</label>
        <input type="number" id="precioVenta" placeholder="Ej: 6.00" step="0.01" min="0" oninput="calcular()">
    </div>

    <div class="results">
        <!-- Bloque Proveedor -->
        <div class="result-box">
            <div class="result-title">1. Resumen del Proveedor</div>
            <div class="result-item">
                <span>IVA Soportado Total (21%):</span>
                <span id="ivaProveedor">0,00 €</span>
            </div>
            <div class="result-item">
                <span>Total pagado al Proveedor (Con IVA):</span>
                <span id="totalProveedor">0,00 €</span>
            </div>
        </div>

        <!-- Bloque Hacienda -->
        <div class="result-box">
            <div class="result-title">2. Liquidación con Hacienda (IVA)</div>
            <div class="result-item">
                <span>IVA Cobrado al Cliente (Repercutido):</span>
                <span id="ivaCliente">0,00 €</span>
            </div>
            <div class="result-item">
                <span>Resultado Cuota IVA (A pagar / Devolver):</span>
                <span id="resultadoIva">0,00 €</span>
            </div>
        </div>

        <!-- Bloque Beneficios -->
        <div class="result-box" style="background-color: #f1f8f5; border-color: #c8e6c9;">
            <div class="result-title">3. Beneficios Netos de la Venta</div>
            <div class="result-item">
                <span>Beneficio Neto (Sin contar ajuste de Hacienda):</span>
                <span id="beneficioSinHacienda" class="highlight-green">0,00 €</span>
            </div>
            <div class="result-item" style="font-size: 15px; border-top: 1px solid #c8e6c9; padding-top: 8px; margin-top: 8px;">
                <span>Beneficio Neto Total (Con ajuste de Hacienda):</span>
                <span id="beneficioTotal" class="highlight-green">0,00 €</span>
            </div>
        </div>
    </div>
</div>

<script>
function calcular() {
    let costeProd = parseFloat(document.getElementById('costeProducto').value) || 0;
    let envios = parseFloat(document.getElementById('gastosEnvio').value) || 0;
    let pvp = parseFloat(document.getElementById('precioVenta').value) || 0;

    // 1. Cálculos de costes y proveedor (Todo al 21% de IVA)
    let baseProveedorTotal = costeProd + envios;
    let ivaProv = baseProveedorTotal * 0.21;
    let totalProvConIva = baseProveedorTotal * 1.21;

    document.getElementById('ivaProveedor').innerText = ivaProv.toFixed(2) + " €";
    document.getElementById('totalProveedor').innerText = totalProvConIva.toFixed(2) + " €";

    // 2. Cálculos de venta e IVA Hacienda
    let baseVenta = pvp / 1.21;
    let ivaCliente = pvp - baseVenta;
    
    // IVA Neto: Positivo a pagar, Negativo a devolver por Hacienda
    let ivaNeto = ivaCliente - ivaProv;

    let textoIva = "";
    let elemIva = document.getElementById('resultadoIva');
    if (ivaNeto > 0) {
        textoIva = "+ " + ivaNeto.toFixed(2) + " € (A pagar a Hacienda)";
        elemIva.className = "highlight-red";
    } else if (ivaNeto < 0) {
        textoIva = ivaNeto.toFixed(2) + " € (A devolver / Acumular)";
        elemIva.className = "highlight-green";
    } else {
        textoIva = "0,00 € (Neutro)";
        elemIva.className = "";
    }
    elemIva.innerText = textoIva;
    document.getElementById('ivaCliente').innerText = ivaCliente.toFixed(2) + " €";

    // 3. Comisiones estimadas (Pasarela 1.8% + 0.25€ y parte proporcional Shopify 0.36€)
    let comisionPasarela = (pvp > 0) ? (pvp * 0.018) + 0.25 : 0;
    let cuotaShopify = (pvp > 0) ? 0.36 : 0;

    // Beneficio sin contar el ajuste de IVA de Hacienda (restando costes de proveedor, comisiones y plataforma)
    // Nota: El coste base que asume la caja sin IVA de proveedor es baseProveedorTotal
    let beneficioSinHacienda = pvp - baseProveedorTotal - comisionPasarela - cuotaShopify;

    // Beneficio Total real (restando también el IVA neto que se paga o sumando si te lo devuelven)
    let beneficioTotal = beneficioSinHacienda - ivaNeto;

    document.getElementById('beneficioSinHacienda').innerText = beneficioSinHacienda.toFixed(2) + " €";
    
    let elemBeneficioTotal = document.getElementById('beneficioTotal');
    elemBeneficioTotal.innerText = beneficioTotal.toFixed(2) + " €";
    if (beneficioTotal < 0) {
        elemBeneficioTotal.className = "highlight-red";
    } else {
        elemBeneficioTotal.className = "highlight-green";
    }
}
</script>

</body>
</html>
